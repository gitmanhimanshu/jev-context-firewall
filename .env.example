# ==============================================================================
# Jev Context Firewall Proxy (.env.example)
# Copy this file to .env and insert your real API keys
# ==============================================================================

# OpenJev / Codiv API Key (Get yours from https://api.codiv.ai)
JEV_API_KEY=your_codiv_api_key_here

# Optional multi-key rotation pool (comma-separated keys to multiply rate limits & concurrency)
JEV_API_KEYS=key1,key2,key3
JEV_CONCURRENCY_PER_KEY=3
JEV_BASE_URL=https://api.codiv.ai
JEV_MODEL=openjev-latest

# Evaluator Mode: "cloud" (OpenJev), "ollama" (Local offline), or "hybrid" (Cloud with local fallback)
JEV_EVALUATOR_MODE=cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Proxy Server Port
PORT=8192

# Default Upstream Provider Endpoints
UPSTREAM_ANTHROPIC=https://api.anthropic.com
UPSTREAM_OPENAI=https://api.openai.com
UPSTREAM_GEMINI=https://generativelanguage.googleapis.com
